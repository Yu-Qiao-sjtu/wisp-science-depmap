    {"id":"lineage_hotspot_mutation_dependency","path":"depmap-26q1-full/lineage_hotspot_mutation_dependency","capabilities":["lineage_mutation_dependency"]},
    {"id":"lineage_cnv_amplification_dependency","path":"depmap-26q1-full/lineage_cnv_amplification_dependency","capabilities":["lineage_cnv_dependency"]},
    {"id":"lineage_sparse_networks","path":"depmap-26q1-full/lineage_sparse_networks","capabilities":["lineage_codependency","lineage_expression_correlation","lineage_expression_dependency"]},
