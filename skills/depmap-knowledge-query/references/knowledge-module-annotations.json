  "capabilities": [
    {
      "id": "pan_cancer_codependency",
      "question_tags": ["gene_relationship", "dependency_network", "transcription_factor", "candidate_discovery"],
      "scope": ["pan_cancer"],
      "inputs": {"source_gene":{"entity_sets":["all_crispr_genes","dorothea_tf_abc"]},"target_gene":{"entity_sets":["all_crispr_genes","dorothea_tf_abc"]}},
      "outputs": ["pearson_correlation", "pair_n", "p_value", "fdr"],
      "method": "Pearson correlation with pairwise complete observations",
      "query": {"mode":"pair_or_top","module":"effect_correlation"},
      "allowed_claims": ["continuous CRISPR co-dependency association"],
      "forbidden_claims": ["causality", "validated synthetic lethality"]
    },
    {
      "id": "pan_cancer_expression_correlation",
      "question_tags": ["gene_relationship", "expression", "transcription_factor", "candidate_discovery"],
      "scope": ["pan_cancer"],
      "inputs": {"source_gene":{"entity_sets":["all_expression_genes","dorothea_tf_abc"]},"target_gene":{"entity_sets":["all_expression_genes","dorothea_tf_abc"]}},
      "outputs": ["pearson_correlation", "pair_n", "p_value", "fdr"],
      "method": "Pearson correlation with pairwise complete observations",
      "query": {"mode":"pair_or_top","module":"expression_correlation"},
      "allowed_claims": ["continuous expression association"],
      "forbidden_claims": ["direct transcriptional regulation", "causality"]
    },
    {
      "id": "pan_cancer_expression_dependency",
      "question_tags": ["expression", "dependency", "transcription_factor", "candidate_discovery"],
      "scope": ["pan_cancer"],
      "inputs": {"source_gene":{"entity_sets":["all_expression_genes","dorothea_tf_abc"]},"target_gene":{"entity_sets":["all_crispr_genes","dorothea_tf_abc"]}},
      "outputs": ["pearson_correlation", "pair_n", "p_value", "fdr"],
      "method": "Pearson correlation between expression and CRISPR Gene Effect",
      "direction": "negative means higher expression associates with stronger dependency",
      "query": {"mode":"pair_or_top","module":"expression_dependency"},
      "allowed_claims": ["continuous expression-dependency association"],
      "forbidden_claims": ["high-versus-low subgroup", "causality"]
    },
    {
      "id": "pan_cancer_mutation_dependency",
      "question_tags": ["mutation", "dependency", "synthetic_lethality", "transcription_factor"],
      "scope": ["pan_cancer"],
      "inputs": {"event_gene":{"entity_sets":["all_crispr_genes","dorothea_tf_abc"]},"target_gene":{"entity_sets":["all_crispr_genes","dorothea_tf_abc"]},"event_type":{"values":["damaging","custom_missense","hotspot"]}},
      "outputs": ["mean_difference", "welch_t", "p_value", "fdr", "event_n", "control_n"],
      "method": "Welch mutation-versus-control dependency contrast; BH FDR within event gene across targets",
      "direction": "negative mean difference means event models are more dependent",
      "query": {"mode":"pair_or_top","modules":["damaging_mutation_dependency","custom_missense_mutation_dependency","hotspot_mutation_dependency"]},
      "allowed_claims": ["observational mutation-context dependency"],
      "forbidden_claims": ["pathogenicity", "causal synthetic lethality"]
    },
    {
      "id": "pan_cancer_cnv_dependency",
      "question_tags": ["copy_number", "amplification", "dependency", "synthetic_lethality", "transcription_factor"],
