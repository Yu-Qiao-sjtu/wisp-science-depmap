      "outputs": ["mean_difference", "welch_t", "p_value", "fdr", "amplified_n", "control_n"],
      "method": "Welch amplified-versus-control dependency contrast; BH FDR within amplified gene across targets",
      "direction": "negative mean difference means amplified models are more dependent",
      "query": {"mode":"pair_or_top","module":"cnv_amplification_dependency"},
      "allowed_claims": ["observational amplification-context dependency"],
      "forbidden_claims": ["copy-number correlation", "causal synthetic lethality"]
    },
