    {"id":"prism_auc_expression_correlation","path":"depmap-26q1-full/prism_auc_expression_correlation","capabilities":["pan_cancer_prism_association"]},
    {"id":"prism_auc_cnv_correlation","path":"depmap-26q1-full/prism_auc_cnv_correlation","capabilities":["pan_cancer_prism_association"]},
    {"id":"lineage_prism_associations","path":"depmap-26q1-full/lineage_prism_associations","capabilities":["lineage_prism_association"]},
