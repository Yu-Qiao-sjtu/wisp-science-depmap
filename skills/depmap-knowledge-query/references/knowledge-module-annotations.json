    {"id":"expression_correlation","path":"depmap-26q1-full/expression_correlation","capabilities":["pan_cancer_expression_correlation"]},
    {"id":"expression_dependency","path":"depmap-26q1-full/expression_dependency","capabilities":["pan_cancer_expression_dependency"]},
