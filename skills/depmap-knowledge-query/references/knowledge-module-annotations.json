{
  "schema_version": 1,
  "release": "26Q1",
  "purpose": "Scientific and routing annotations for completed knowledge assets. Physical presence, computation completion, query exposure, and claim support are separate fields.",
  "discovery_contract": {
    "default_candidate_limit": 8,
    "minimum_candidate_limit": 3,
    "maximum_candidate_limit": 8,
    "score_weights": {
      "question_tag": 100,
      "entity_set": 80,
      "lineage_direct": 30,
      "query_exposed": 20,
      "installed": 10
    },
    "tie_breakers": ["lineage_direct", "query_exposed", "installed", "capability_id"],
    "note": "Discovery ranks annotated capabilities only. A match is not a scientific result and does not imply lineage eligibility."
  },
  "entity_sets": [
    {
      "id": "all_crispr_genes",
      "entity_type": "gene",
      "typical_count": 18531,
      "roles": ["source_gene", "target_gene"],
      "description": "Genes represented in the CRISPR Gene Effect matrix."
    },
    {
      "id": "all_expression_genes",
      "entity_type": "gene",
      "typical_count": 19215,
      "roles": ["source_gene", "target_gene"],
      "description": "Protein-coding genes represented in the expression matrix."
    },
    {
      "id": "dorothea_tf_abc",
      "entity_type": "gene_set",
      "typical_count": 270,
      "roles": ["source_gene", "target_gene", "regulator"],
      "description": "DoRothEA confidence A-C transcription-factor set. It is an entity-set selector and may be expanded across compatible gene roles; it is not restricted to the enrichment module.",
      "resolver": {
        "kind": "enrichment_term_members",
        "module": "lineage_gene_enrichment",
        "collection": "DOROTHEA_TF_ABC",
        "member_column": "term",
        "strip_suffix": "_TARGETS"
      }
    },
    {
      "id": "hallmark_gene_sets",
      "entity_type": "pathway_collection",
      "typical_count": 50,
      "roles": ["pathway"]
    },
    {
      "id": "reactome_2023_2_gene_sets",
      "entity_type": "pathway_collection",
      "typical_count": 1692,
      "roles": ["pathway"]
    },
    {
      "id": "prism_compounds",
      "entity_type": "drug",
      "typical_count": 1482,
      "roles": ["drug"]
    }
  ],
  "storage_modules": [
