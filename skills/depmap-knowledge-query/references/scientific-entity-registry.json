{
  "schema_version": 1,
  "release": "26Q1",
  "purpose": "Canonical, auditable entity boundary between model-extracted scientific language and DepMap/TCGA query identifiers.",
  "resolution_states": {
    "RESOLVED": "Exactly one registry or installed-catalog entity is selected.",
    "AMBIGUOUS": "Multiple valid entities remain and user confirmation is required.",
    "NOT_FOUND": "No registry or installed-catalog entity matched; this is not a biological result.",
    "NORMALIZED_UNVERIFIED": "A query-safe spelling was produced but existence has not been verified against an installed catalog.",
    "INVALID_CANDIDATES": "One or more model-proposed candidates are outside the maintained registry."
  },
  "entity_types": {
    "cancer": {
      "namespace": "depmap-lineage",
      "resolver": "maintained_vocabulary",
      "selection_policy": "exact aliases auto-resolve; broad or ambiguous terms require confirmation",
      "relation": "model_grouping_proxy"
    },
    "gene": {
      "namespace": "hgnc",
      "resolver": "installed_catalog",
      "catalog": "depmap-26q1-core/gene_catalog.parquet",
      "canonical_field": "symbol",
      "identifier_field": "hgnc_id",
      "alias_fields": ["alias_symbol", "prev_symbol"],
      "membership_fields": ["in_crispr_effect", "in_crispr_dependency", "in_analysis_set"]
    },
    "drug": {
      "namespace": "depmap-prism-compound",
      "resolver": "installed_catalog",
      "catalog_candidates": [
        "depmap-26q1-full/prism_auc_effect_correlation/drug_order.csv",
        "depmap-26q1-full/prism_auc_expression_correlation/drug_order.csv",
        "depmap-26q1-full/prism_auc_cnv_correlation/drug_order.csv"
      ],
      "canonical_field": "ConditionCompoundName",
      "identifier_field": "CompoundID",
      "alias_fields": ["ConditionSampleID", "ChEMBLID", "PubChemCID"]
    },
    "pathway": {
      "namespace": "depmap-pathway",
      "resolver": "query_validated",
      "normalization": "uppercase_underscore",
      "verification_note": "The enrichment query and its manifest determine whether the term exists and was retained."
    },
    "phenotype": {"namespace": "wisp-phenotype", "resolver": "capability_concepts", "concept_category": "phenotypes"},
    "molecular_focus": {"namespace": "wisp-molecular-focus", "resolver": "capability_concepts", "concept_category": "molecular_focus"},
    "mechanism": {"namespace": "wisp-mechanism", "resolver": "capability_concepts", "concept_category": "mechanisms"},
    "evidence_source": {"namespace": "wisp-evidence-source", "resolver": "capability_concepts", "concept_category": "evidence_sources"},
    "requested_output": {"namespace": "wisp-requested-output", "resolver": "capability_concepts", "concept_category": "requested_outputs"}
  },
