          ],
          "defaults": {
            "collection": "hallmark",
            "rank_metric": "negative_signed_t",
            "min_pair_fraction": 0.8
          },
          "cache_policy": "exact release, source gene, scope, collection, database version, rank metric, pair threshold, gene-set size, display count, and seed match"
