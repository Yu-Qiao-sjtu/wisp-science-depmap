{
  "manifest_version": 3,
  "name": "Wisp DepMap Browser Bridge",
  "version": "0.4.1",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "Connects Wisp DepMap to tabs in this persistent Chrome/Chromium profile. This is a separate extension from Wisp Science.",
  "permissions": ["alarms", "debugger", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wisp DepMap Browser Bridge"
  }
}
