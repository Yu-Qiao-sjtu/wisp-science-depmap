[Unit]
Description=Wisp Science DepMap Knowledge API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/data/gz0548/depmap-kb-api
EnvironmentFile=/home/data/gz0548/depmap-kb-api/.env
Environment=PYTHONUNBUFFERED=1
Environment=NO_PROXY=*
Environment=OMP_NUM_THREADS=4
Environment=ARROW_NUM_THREADS=4
Environment=R_DATATABLE_NUM_PROCS_PERCENT=10
ExecStart=/home/data/gz0548/depmap-agent/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8876 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/data/gz0548/depmap-26q1
MemoryMax=8G
TasksMax=64

[Install]
WantedBy=default.target
